# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are added).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase Cloud Sync (App works 100% Guest-First / Offline-First without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
